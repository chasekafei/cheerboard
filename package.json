{
  "name": "cheerboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "离线手机手幅与灯牌小工具",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "pnpm check && node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "esbuild": "~0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
